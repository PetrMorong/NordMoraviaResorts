# Vzor pro lokální vývoj – zkopírujte jako .env (ten se do gitu NEDÁVÁ) a doplňte.
# Na Netlify se stejné proměnné zadávají v Site configuration → Environment variables.

# --- Platební brána ČSOB ---
CSOB_ENV=test
CSOB_MERCHANT_ID=
# lokálně stačí cesta k souboru s privátním klíčem (rsa_M1MIPS….key), na Netlify vložte celý obsah do CSOB_PRIVATE_KEY
CSOB_PRIVATE_KEY_FILE=
# CSOB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n…\n-----END RSA PRIVATE KEY-----"

# --- Previo (zatím vypnuté – ceny se berou z ceníku v CMS) ---
PREVIO_LIVE=0
PREVIO_HOTEL_ID=769376
PREVIO_API_KEY=
# PREVIO_ZALOHOVY_LIST=1

# --- Reservio (privátní wellness k pobytu) ---
RESERVIO_TOKEN=
RESERVIO_BUSINESS_ID=

# --- Vila Republika (přípona _VR; co chybí, bere se ze společné proměnné – ČSOB je společná) ---
RESERVIO_TOKEN_VR=
RESERVIO_BUSINESS_ID_VR=
# PREVIO_LIVE_VR=1
# PREVIO_API_KEY_VR=
